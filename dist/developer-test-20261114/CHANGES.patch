+    core.speak(" ".join(parts))
+
+def _side(room, obj):
+    import tyjokr_a11y_plus_build as build
+    x1, z1, x2, z2 = _box(room)
+    try:
+        x, z = build.frame().local(float(obj.position.x), float(obj.position.z))

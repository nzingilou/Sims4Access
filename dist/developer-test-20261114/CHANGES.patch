index 0000000..4715055
--- /dev/null
+++ b/Scripts/tyjokr_a11y_basement.py
@@ -0,0 +1,335 @@
+"""Experimental native basement drawing, isolated from ordinary room workers."""
+import configparser
+import math
+import threading
+import time
+
+_build = None
+_core = None
+_helpers = None
+_original_room = None
+_original_menu = None
+_original_reply = None
+_original_render = None
+_selection = None
+_failure = threading.local()
+SETTING = 'experimental_basement'
+TOOL = 'Basement Tool'
+
+
+def _log(kind, **data):
+    import json
+    import tyjokr_a11y_speech as speech
+    speech.log_line('basement adapter: ' + json.dumps(dict(kind=kind, **data), sort_keys=True, default=str))
+
+
+def _enabled():
+    import tyjokr_a11y_settings as settings
+    return bool(settings.get(SETTING, True))
+
+
+def _context():
+    import services
+    state = _helpers._state()
+    state['household'] = int(services.active_household_id())
+    return state
+
+
+def _same_context(state):
+    import services
+    return (_enabled() and _helpers._same_world(state)
+            and int(services.active_household_id()) == state['household'])
+
+
+def _rooms():
+    result = _build._room_ids()
+    if result is None: raise RuntimeError('The game did not supply its room geometry')
+    return {(tuple(box), int(level)) for box, level in result}
+
+
+def _overlap(a, b):
+    return max(a[0], b[0]) < min(a[2], b[2]) and max(a[1], b[1]) < min(a[3], b[3])
+
+
+def _bounds(want, frame):
+    if len(want) != 4 or any(isinstance(v, bool) or not isinstance(v, (int,float))
+            or not math.isfinite(v) or int(v) != v for v in want):
+        raise ValueError('Basement corners must be four whole-metre coordinates')
+    box = tuple(int(v) for v in want)
+    if not (1 <= box[0] < box[2] <= frame.width-1 and 1 <= box[1] < box[3] <= frame.depth-1):
+        raise ValueError('The basement must fit at least one metre inside the lot')
+    return box
+
+
+def _reply(encoded=''):
+    # Leave all existing catalog, placement and scanner reply behavior intact.
+    result = _original_reply(encoded)
+    job = _selection
+    if job is not None:
+        try:
+            from urllib.parse import unquote
+            parts = unquote(str(encoded or '')).split('|')
+            if (len(parts) == 3 and parts[0] == 'selected'
+                    and parts[1] == str(job['index']) and unquote(parts[2]) == job['name']
+                    and _build._cat['serial'] == job['serial']):
+                job['done'].set()
+        except Exception:
+            _core.log_exc('basement tool reply')
+    return result
+
+
+def _tool(name, state):
+    global _selection
+    if not _build.on_main(_same_context, state): return False
+    # The native bridge replaces its catalog array. An old index must never
+    # reselect an unrelated tool if this query or selection is interrupted.
+    _build.on_main(_build._cat.pop, 'chosen', None)
+    items = _build.fetch_catalog(16, '', 'tool') or []
+    names = [item[0] for item in items]
+    _log('catalog', wanted=name, tools=names)
+    if name not in names or not _build.on_main(_same_context, state): return False
+    index = names.index(name)
+    job = {'index':index, 'name':name, 'serial':_build._cat['serial'], 'done':threading.Event()}
+    _selection = job
+    silent = _build._cat.get('silent_select', False)
+    try:
+        _build._cat['silent_select'] = True
+        _build.select_item(index, name)
+        acknowledged = job['done'].wait(2.0)
+        _log('tool-selection', name=name, acknowledged=acknowledged)
+        return acknowledged and bool(_build.on_main(_same_context, state))
+    finally:
+        _selection = None
+        _build._cat['silent_select'] = silent
+
+
+def _check_result(before, after, wanted):
+    target = (wanted, -1)
+    # A bounding box alone cannot count a ground-floor room as a basement.
+    return target in after-before and before.issubset(after) and after-before == {target}
+
+
+def _rectangle(wanted):
+    import tyjokr_a11y_plus_rooms as rooms
+    frame = _build.frame()
+    matches = [r for r in rooms.scan_rooms() if int(r.level) == -1 and _build._room_box(r) == wanted]
+    if len(matches) != 1: return False
+    actual = {(int(math.floor(frame.local(x,z)[0])), int(math.floor(frame.local(x,z)[1]))) for x,z in matches[0].tiles}
+    expected = {(x,z) for x in range(wanted[0],wanted[2]) for z in range(wanted[1],wanted[3])}
+    return actual == expected
+
+
+def _draw(want, overview):
+    state = _build.on_main(_context)
+    if not state: raise RuntimeError('The simulation thread did not answer')
+    frame = _build.on_main(_build.frame)
+    if frame is None: raise RuntimeError('The lot geometry is unavailable')
+    wanted = _bounds(want, frame)
+    before = _build.on_main(_rooms)
+    if before is None: raise RuntimeError('Room inspection timed out')
+    if any(level == -1 and _overlap(box,wanted) for box,level in before):
+        _log('occupied', wanted=wanted)
+        return 'occupied'
+    if not _build.set_floor(0): return 'nofloor'
+    selected = False
+    attempted = False
+    result = 'nocatalog'
+    restore_ok = True
+    try:
+        attempted = True
+        selected = _tool(TOOL, state)
+        if not selected:
+            _core.post(_core.speak, 'The native Basement Tool was not confirmed. Nothing was drawn. Its catalog entries were logged.')
+            return 'nocatalog'
+        points = [frame.world(wanted[0],wanted[1]), frame.world(wanted[2],wanted[3])]
+        started = time.monotonic()
+        funds_before = _build.on_main(_build.funds)
+        def action(screen):
+            if not _build.on_main(_same_context,state): raise RuntimeError('Build context changed before the basement drag')
+            if not _tool(TOOL,state): raise RuntimeError('The Basement Tool could not be confirmed after camera preparation')
+            info = _helpers._native_floor(state)
+            if info['floor'] != 0: raise RuntimeError('The game is no longer showing the ground floor')
+            _log('drag', wanted=wanted, input_floor=0, expected_floor=-1, native_floor=info)
+            _build.drag(screen[0],screen[1])
+        performed = _build.point_and_act(points,0,action,'experimental basement {}'.format(wanted),overview=overview)
+        if not performed: return 'noscreen'
+        _log('after-drag', native_floor=_helpers._native_floor(state), funds_before=funds_before, funds_after=_build.on_main(_build.funds))
+        after = before
+        for attempt in range(20):
+            if not _build.on_main(_same_context,state): raise RuntimeError('Build context changed while checking the basement')
+            after = _build.on_main(_rooms)
+            if after is None: raise RuntimeError('Basement verification timed out')
+            if after != before: break
+            time.sleep(.25)
+        okay = _check_result(before,after,wanted) and bool(_build.on_main(_rectangle,wanted))
+        error = _build._last_error
+        reason = error.get('text','') if error.get('at',0) >= started else ''
+        _log('verification', wanted=wanted, expected_floor=-1, new=sorted(after-before),
+             removed=sorted(before-after), success=okay, game_reason=reason)
+        result = wanted if okay else 'unverified'
+        if not okay:
+            _core.post(_core.speak, 'Basement construction stopped: the game did not confirm the requested room on floor minus one.'
+                       + (' Game message: '+reason if reason else '') + ' Inspect the result before using Undo or trying again.')
+    finally:
+        # Never leave Basement Tool selected for the next above-ground room.
+        if attempted:
+            if _build.on_main(_same_context,state): restore_ok = _tool('Room Tool',state)
+            else: restore_ok = False
+            _log('restore-room-tool', success=restore_ok)
+    if not restore_ok:
+        _core.post(_core.speak,'The basement step stopped because the ordinary Room Tool could not be restored.')
+        return 'nocatalog'
+    return result
+
+
+def failure_reason():
+    return getattr(_failure,'reason','')
+
+
+def room_worker(want, overview=False, tries=4, level=0):
+    _failure.reason = ''
+    if level != -1:
+        return _original_room(want,overview=overview,tries=tries,level=level)
+    if not _enabled():
+        _core.post(_core.speak,'Experimental basement creation is off in accessibility settings.')
+        result = 'disabled'
+    else:
+        try:
+            result = _draw(want,overview)
+        except Exception as exc:
+            _log('stopped', wanted=want, error=str(exc))
+            _core.post(_core.speak,'Basement construction stopped. '+str(exc))
+            result = 'unverified'
+    if result != tuple(want):
+        _failure.reason = {'disabled':'experimental basement creation is turned off',
+                          'occupied':'the requested footprint overlaps an existing basement room',
+                          'nofloor':'the game could not reach the ground floor for the basement tool',
+                          'nocatalog':'the required native tool selection was not confirmed',
+                          'noscreen':'the corners could not be framed clear of the interface'}.get(result,'the requested room on floor minus one could not be verified')
+    return result
+
+
+def _start_room(wanted):
+    if _build._busy[0]:
+        _core.speak('Still working on the last build step.'); return
+    if not _enabled():
+        _core.speak('Turn on experimental basement creation in accessibility settings first.'); return
+    _build._busy[0] = True
+    _core.speak('Building the basement room. Please do not press keys until it finishes.')
+    def work():
+        try:
+            result = room_worker(wanted,overview=True,level=-1)
+            if result == wanted:
+                shown = _build.set_floor(-1)
+                _core.post(_core.speak,'The basement room was verified on floor minus one. '
+                           + ('The game now shows the basement.' if shown else 'The room exists, but the game could not switch to its floor.'))
+            else:
+                _core.post(_core.speak,'The basement room was not completed: {}. No further rooms were attempted.'.format(result))
+        finally:
+            _build._busy[0] = False
+    try: threading.Thread(target=work,name='a11y_basement_room',daemon=True).start()
+    except Exception:
+        _build._busy[0] = False
+        raise
+
+
+def _ask_room():
+    def size(text):
+        values = _build._numbers(text)
+        if len(values) != 2 or any(v < 1 or v > 30 for v in values):
+            _core.speak('Type a width and depth between 1 and 30 metres.'); return
+        width,depth = values
+        def position(text):
+            coords = _build._numbers(text)
+            if len(coords) != 2:
+                _core.speak('Type meters from west and north, for example 2 3.'); return
+            wanted = (coords[0],coords[1],coords[0]+width,coords[1]+depth)
+            try: _bounds(wanted,_build.frame())
+            except ValueError as exc: _core.speak(str(exc)); return
+            rows=[('Build this basement room','Uses the native tool and spends household funds only if the game accepts it.',True),('Cancel',None,False)]
+            _core.choose('Confirm experimental basement','{} by {} metres, {} from west and {} from north. Floor minus one. Existing basement rooms must not overlap this footprint.'.format(width,depth,*coords),rows,
+                         lambda yes:_start_room(wanted) if yes else None,tag='build')
+        _core.ask_text('Basement position','Type meters from the west edge, then the north edge of the lot. For example 2 3.','',position)
+    _core.ask_text('Basement size','Type width west to east and depth north to south in metres, for example 4 5.','',size)
+
+
+def _inspect():
+    if _build._busy[0]: _core.speak('Still working on the last build step.'); return
+    _build._busy[0] = True
+    def work():
+        try:
+            state = _build.on_main(_context)
+            info = _helpers._native_floor(state)
+            geometry = _build.on_main(_rooms)
+            if geometry is None: raise RuntimeError('Room inspection timed out')
+            basements = sorted(box for box,level in geometry if level == -1)
+            _log('inspect', basement_rooms=basements, native_floor=info)
+            _core.post(_core.speak,'Logged current floor bounds and {} basement rooms. Nothing was built or selected.'.format(len(basements)))
+        except Exception as exc:
+            _log('inspect-failed',error=str(exc)); _core.post(_core.speak,'Basement inspection failed. '+str(exc))
+        finally: _build._busy[0] = False
+    try: threading.Thread(target=work,name='a11y_basement_inspect',daemon=True).start()
+    except Exception:
+        _build._busy[0] = False; raise
+
+
+def open_assistant():
+    if not _build.in_build_mode(): _core.speak('Enter Build mode first.'); return
+    rows=[('Build a rectangular basement room','Choose size and position; verifies floor minus one before reporting success.',_ask_room),
+          ('Inspect basement floors and rooms','Read-only native-floor and room diagnostics; builds and selects nothing.',_inspect)]
+    _core.choose('Basement assistant (experimental)','Stacked houses with a basement use the same adapter automatically. Creation can be turned off in accessibility settings.',rows,lambda fn:fn(),tag='build')
+
+
+def _open_menu():
+    choose = _core.choose
+    def extended(title,prompt,rows,callback,tag=None,*args,**kwargs):
+        if title == 'Build helper':
+            rows=list(rows)+[('Basement assistant (experimental)','Build a basement room or inspect native floors and existing rooms.',open_assistant)]
+        return choose(title,prompt,rows,callback,tag,*args,**kwargs)
+    _core.choose = extended
+    try: return _original_menu()
+    finally: _core.choose = choose
+
+
+def _render(stored):
+    import tyjokr_a11y_settings as settings
+    base = _original_render(stored)
+    line = 'experimental basement = {}\n'.format('on' if stored.get(SETTING,settings.DEFAULTS[SETTING]) else 'off')
+    marker = '[contribution]\n'
+    return base.replace(marker,marker+line,1) if marker in base else base.rstrip()+'\n\n'+marker+line
+
+
+def _install_setting():
+    global _original_render
+    import tyjokr_a11y_settings as settings
+    import tyjokr_a11y_menu as menu
+    settings.DEFAULTS.setdefault(SETTING,True)
+    settings._FILE_MAP[('contribution','experimental basement')] = SETTING
+    if SETTING not in settings._BOOL_KEYS: settings._BOOL_KEYS = tuple(settings._BOOL_KEYS)+(SETTING,)
+    parser = configparser.ConfigParser(interpolation=None,strict=False,inline_comment_prefixes=(';','#'))
+    try:
+        with open(settings.PATH,'r',encoding='utf-8') as handle: parser.read_file(handle)
+        value = parser.get('contribution','experimental basement',fallback='').strip().lower()
+        if value in settings._TRUE_WORDS: settings._stored[SETTING] = True
+        elif value in settings._FALSE_WORDS: settings._stored[SETTING] = False
+    except (OSError,configparser.Error): pass
+    _original_render = settings._render
+    settings._render = _render
+    if not any(row.key==SETTING for row in menu.ROWS):
+        index = next((i for i,row in enumerate(menu.ROWS) if row.key=='reload'),len(menu.ROWS))
+        menu.ROWS.insert(index,menu.Row(SETTING,'bool','experimental basement creation',help='uses the native Basement Tool from ground level and verifies the result below'))
+        menu._SETTING_ROWS = [row for row in menu.ROWS if row.kind!='action']
+
+
+def install():
+    global _build,_core,_helpers,_original_room,_original_menu,_original_reply
+    import tyjokr_a11y_plus_build as build
+    import tyjokr_a11y_plus_core as core
+    import tyjokr_a11y_build_helpers as helpers
+    if getattr(build,'_basement_adapter_installed',False): return
+    _build,_core,_helpers = build,core,helpers
+    _install_setting()
+    _original_room,_original_menu,_original_reply = build.room_worker,build.open_menu,build._flash_reply
+    build.room_worker,build.open_menu,build._flash_reply = room_worker,_open_menu,_reply
+    build._basement_adapter_installed = True
+    _log('installed',experimental=True,enabled=_enabled())
diff --git a/Scripts/tyjokr_a11y_build_coordinates.py b/Scripts/tyjokr_a11y_build_coordinates.py
new file mode 100644
index 0000000..3e82d5c
--- /dev/null
+++ b/Scripts/tyjokr_a11y_build_coordinates.py
@@ -0,0 +1,315 @@
+"""Measured UI -> client -> physical-screen boundary for build helpers.
+
+No resolution presets or extra DPI multiplier. Native projection is read-only;
+actual clicks/drags remain the existing helpers and the game's validation.
+"""
+import contextlib
+import ctypes
+import json
+import math
+import os
+import threading
+import time
+from urllib.parse import unquote
+import sims4.commands
+import tyjokr_a11y_speech as speech
+import tyjokr_a11y_display_diagnostic as display
+
+_build = None
+_frame = None
+_serial = 0
+_pending = {}
+_lock = threading.Lock()
+_local = threading.local()
+
+
+def _log(kind, **data):
+    speech.log_line('build coordinates: ' + json.dumps(dict(kind=kind, **data), sort_keys=True, default=str))
+
+
+def _api():
+    u = display._api()
+    signatures = {
+        'SetThreadDpiAwarenessContext': (ctypes.c_void_p, [ctypes.c_void_p]),
+        'SetCursorPos': (ctypes.c_int32, [ctypes.c_int32, ctypes.c_int32]),
+        'mouse_event': (None, [ctypes.c_uint32, ctypes.c_uint32, ctypes.c_uint32, ctypes.c_uint32, ctypes.c_size_t]),
+        'GetAsyncKeyState': (ctypes.c_short, [ctypes.c_int32]),
+        'GetAncestor': (ctypes.c_void_p, [ctypes.c_void_p, ctypes.c_uint32]),
+        'keybd_event': (None, [ctypes.c_ubyte, ctypes.c_ubyte, ctypes.c_uint32, ctypes.c_size_t]),
+    }
+    for name, (result, args) in signatures.items():
+        fn = getattr(u, name)
+        fn.restype, fn.argtypes = result, args
+    return u
+
+
+@contextlib.contextmanager
+def physical_context(u):
+    previous = u.SetThreadDpiAwarenessContext(ctypes.c_void_p(-4))
+    if not previous: raise RuntimeError('Per-monitor coordinate context unavailable')
+    try: yield
+    finally:
+        if not u.SetThreadDpiAwarenessContext(previous):
+            _log('dpi-restore-failed')
+            raise RuntimeError('Thread DPI context could not be restored')
+
+
+def window(u):
+    hwnd = u.GetForegroundWindow()
+    pid = ctypes.c_uint32()
+    if not hwnd or not u.GetWindowThreadProcessId(hwnd, ctypes.byref(pid)) or pid.value != os.getpid():
+        raise RuntimeError('The game must remain focused')
+    if u.GetAncestor(hwnd,3)!=hwnd:raise RuntimeError('Close the native game dialog before building')
+    if u.IsIconic(hwnd): raise RuntimeError('The game window is minimized')
+    rect = display.RECT(); origin = display.POINT(0, 0)
+    if not u.GetClientRect(hwnd, ctypes.byref(rect)) or not u.ClientToScreen(hwnd, ctypes.byref(origin)):
+        raise RuntimeError('Game window geometry unavailable')
+    w, h = int(rect.right-rect.left), int(rect.bottom-rect.top)
+    desktop = tuple(int(u.GetSystemMetrics(i)) for i in (76,77,78,79))
+    if min(w,h,desktop[2],desktop[3]) < 100: raise RuntimeError('Invalid game window dimensions')
+    return (int(hwnd),origin.x,origin.y,w,h,int(u.GetDpiForWindow(hwnd)),desktop,
+            int(u.GetWindowLongPtrW(hwnd,-16)))
+
+
+def capture_window():
+    u = _api()
+    with physical_context(u): return window(u)
+
+
+class Frame:
+    def __init__(self, zone, width, height, mode, bounds, layout, geometry, align=''):
+        if not all(math.isfinite(v) for v in (width,height,*bounds,*layout)):
+            raise ValueError('Non-finite viewport')
+        if not (100 <= width <= 100000 and 100 <= height <= 100000): raise ValueError('Invalid viewport')
+        if mode not in ('noScale','exactFit','showAll','noBorder'): raise ValueError('Unverified stage scale mode: '+mode)
+        if mode in ('showAll','noBorder') and align not in ('','T','B','L','R','TL','TR','BL','BR','LT','RT','LB','RB'):
+            raise ValueError('Unknown stage alignment: '+repr(align))
+        if min(layout) < 100 or not (0 <= bounds[0] < bounds[2] <= layout[0] and 0 <= bounds[1] < bounds[3] <= layout[1]):
+            raise ValueError('Invalid build bounds')
+        self.zone,self.width,self.height,self.mode,self.geometry=zone,width,height,mode,geometry
+        self.sx,self.sy=geometry[3]/width,geometry[4]/height
+        self.ox=self.oy=0.0
+        if mode in ('showAll','noBorder'):
+            self.sx=self.sy=(min if mode=='showAll' else max)(self.sx,self.sy)
+            free_x,free_y=geometry[3]-width*self.sx,geometry[4]-height*self.sy
+            self.ox=0.0 if 'L' in align else free_x if 'R' in align else free_x/2
+            self.oy=0.0 if 'T' in align else free_y if 'B' in align else free_y/2
+        self.bounds=(bounds[0]*width/layout[0],bounds[1]*height/layout[1],bounds[2]*width/layout[0],bounds[3]*height/layout[1])
+    def client(self, x, y, offset=(0,0)):
+        x,y=float(x)+offset[0],float(y)+offset[1]
+        if not (math.isfinite(x) and math.isfinite(y) and 0 <= x < self.width and 0 <= y < self.height):
+            raise ValueError('Projected point is outside the game viewport')
+        result=(int(round(self.ox+x*self.sx)),int(round(self.oy+y*self.sy)))
+        if not (0<=result[0]<self.geometry[3] and 0<=result[1]<self.geometry[4]):raise ValueError('Projected point is cropped from the viewport')
+        return result
+    def clear(self,p):
+        x,y=p;left,top,right,bottom=self.bounds
+        return left <= x <= right and top <= y <= bottom and .02*self.width <= x <= .98*self.width and .08*self.height <= y <= .70*self.height
+
+
+@sims4.commands.Command('a11y.coords_enc', command_type=sims4.commands.CommandType.Live)
+def receive(text: str = '', _connection=None):
+    try:
+        if len(text)>3000:return False
+        fields=unquote(text).split('|')
+        if len(fields)!=15:return False
+        ident=int(fields[0]);zone=int(fields[1]);status=fields[2]
+        with _lock:job=_pending.get(ident)
+        if job is None or job['zone']!=zone:return False
+        if status not in ('point','viewport'):
+            job['result']={'status':status};job['event'].set();return True
+        values=[float(fields[i]) for i in (3,4,5,6,9,10,11,12,13,14)]
+        if not all(math.isfinite(v) for v in values[2:]):return False
+        if status=='point' and not all(math.isfinite(v) for v in values[:2]):return False
+        job['result']={'status':status,'zone':zone,'point':tuple(values[:2]),'width':values[2],'height':values[3],
+                       'mode':fields[7],'align':fields[8],'layout':tuple(values[4:6]),'bounds':tuple(values[6:10])}
+        job['event'].set();return True
+    except Exception as exc:
+        _log('reply-rejected',error=type(exc).__name__);return False
+
+
+def _measure(x,z,level,height=0.0,timeout=3.0):
+    global _serial,_frame
+    before=capture_window()
+    with _lock:
+        _serial=(_serial%2147483646)+1;ident=_serial
+        job={'event':threading.Event(),'zone':None,'result':None}
+        _pending[ident]=job
+    def start():
+        try:
+            import services
+            job['zone']=int(services.current_zone_id())
+            y=_build.floor_height(x,z,level)+height
+            _build._send_ui('A11y|coords|{}|{:.6f}|{:.6f}|{:.6f}|{}|{}'.format(ident,x,y,z,level,job['zone']))
+        except Exception as exc:
+            job['result']={'status':'request-error','error':type(exc).__name__};job['event'].set()
+    _build.core.post(start)
+    try:
+        if not job['event'].wait(timeout):raise RuntimeError('Projection measurement timed out; check paired UI packages')
+        result=job['result']
+        if not result or result['status'] not in ('point','viewport'):raise RuntimeError('Projection refused: '+str(result))
+        after=capture_window()
+        if before!=after:raise RuntimeError('Game window changed during projection')
+        _log('raw-measure',response=result,window=after)
+        frame=Frame(result['zone'],result['width'],result['height'],result['mode'],result['bounds'],result['layout'],after,result['align'])
+        _frame=frame
+        _log('measure',response=result,window=after)
+        return result,frame
+    finally:
+        with _lock:_pending.pop(ident,None)
+
+
+def project(x,z,level,timeout=2.5,height=0.0):
+    try:
+        result,frame=_measure(x,z,level,height,timeout=max(2.5,timeout))
+        return result['point'] if result['status']=='point' else None
+    except Exception as exc:
+        _log('project-refused',error=str(exc));return None
+
+
+def _current(u):
+    frame=getattr(_local,'input_frame',None) or _frame
+    if frame is None:raise RuntimeError('Measure the game viewport before building')
+    if window(u)!=frame.geometry:raise RuntimeError('Game focus, size, position or DPI changed; retry the operation')
+    import sys
+    keys=sys.modules.get('tyjokr_a11y_keys')
+    if keys is not None and (getattr(keys,'_editing_active',False) or keys.blocking_active()):
+        raise RuntimeError('Close the open game dialog before building')
+    return frame
+
+
+def stage_size():
+    u=_api()
+    with physical_context(u):f=_current(u);return f.width,f.height
+
+
+def to_screen(x,y):
+    u=_api()
+    with physical_context(u):
+        f=_current(u);cx,cy=f.client(x,y,_build.OFFSET)
+        point=display.POINT(cx,cy)
+        if not u.ClientToScreen(f.geometry[0],ctypes.byref(point)):raise RuntimeError('Client conversion failed')
+        _log('convert',ui=[x,y],client=[cx,cy],screen=[point.x,point.y],window=f.geometry)
+        return point.x,point.y
+
+
+def _release(u):
+    if getattr(_local,'down',False):
+        u.mouse_event(4,0,0,0,0);_local.down=False
+
+
+def move_to(x,y):
+    u=_api()
+    try:
+        with physical_context(u):
+            f=_current(u);g=f.geometry;x,y=int(round(x)),int(round(y))
+            if not _build.on_main(_safe_game,f.zone):raise RuntimeError('Build Mode changed during pointer operation')
+            _current(u)
+            if not (g[1]<=x<g[1]+g[3] and g[2]<=y<g[2]+g[4]):raise RuntimeError('Mouse point is outside the game window')
+            left,top,w,h=g[6]
+            nx=int(round((x-left)*65535/max(1,w-1)));ny=int(round((y-top)*65535/max(1,h-1)))
+            if not (0<=nx<=65535 and 0<=ny<=65535):raise RuntimeError('Mouse point outside virtual desktop')
+            if not u.SetCursorPos(x,y):raise RuntimeError('Pointer positioning failed')
+            u.mouse_event(0xc001,nx,ny,0,0)
+            p=display.POINT()
+            if not u.GetPhysicalCursorPos(ctypes.byref(p)) or abs(p.x-x)>2 or abs(p.y-y)>2:
+                raise RuntimeError('Physical pointer did not reach the requested point')
+            _local.last=(x,y)
+    except Exception:
+        _release(u);raise
+
+
+def _safe_game(zone):
+    import services
+    import tyjokr_a11y_place as place
+    import tyjokr_a11y_keys as keys
+    return place.in_build_mode() and int(services.current_zone_id())==zone and not keys.blocking_active() and not keys._editing_active
+
+
+def mouse(flags,data=0):
+    u=_api()
+    if flags==_build.LEFT_UP:
+        u.mouse_event(flags,0,0,data,0);_local.down=False;return
+    if flags!=_build.LEFT_DOWN:
+        return _original_mouse(flags,data)
+    try:
+        with physical_context(u):
+            f=_current(u)
+            if not _build.on_main(_safe_game,f.zone):raise RuntimeError('Build context changed before click')
+            p=display.POINT();last=getattr(_local,'last',None)
+            if last is None or not u.GetPhysicalCursorPos(ctypes.byref(p)) or max(abs(p.x-last[0]),abs(p.y-last[1]))>2:
+                raise RuntimeError('Pointer moved before click')
+            _current(u)
+            u.mouse_event(flags,0,0,data,0);_local.down=True
+    except Exception:
+        _release(u);raise
+
+
+def clear_of_panels(point):
+    try:
+        u=_api()
+        with physical_context(u):return _current(u).clear(point)
+    except Exception:return False
+
+
+def _guarded_action(original,args,shift):
+    u=_api()
+    with physical_context(u):
+        f=_current(u)
+        if shift and u.GetAsyncKeyState(0x10)&0x8000:raise RuntimeError('Release Shift before using this helper')
+        _local.input_frame=f
+        try:return original(*args,shift=shift)
+        finally:
+            _release(u)
+            if shift:u.keybd_event(0x10,0x2a,2,0)
+            _local.input_frame=None
+
+
+def park_mouse():
+    try:
+        u=_api()
+        with physical_context(u):
+            g=window(u)
+            u.SetCursorPos(g[1]+g[3]//2,g[2]+g[4]//3)
+    except Exception:pass
+
+
+def install():
+    global _build,_original_mouse
+    import tyjokr_a11y_plus_build as build
+    if getattr(build,'_measured_coordinates_installed',False):return
+    _build=build;_original_mouse=build._mouse
+    original_click,original_drag=build.click,build.drag
+    def click(a,shift=False):return _guarded_action(original_click,(a,),shift)
+    def drag(a,b,shift=False):return _guarded_action(original_drag,(a,b),shift)
+    build.project=project;build._stage_size=stage_size;build._to_screen=to_screen
+    build.move_to=move_to;build._mouse=mouse;build.click=click;build.drag=drag
+    build._clear_of_panels=clear_of_panels;build.park_mouse=park_mouse
+    build._measured_coordinates_installed=True
+    _log('installed')
+
+
+@sims4.commands.Command('a11y.buildcoords', command_type=sims4.commands.CommandType.Live)
+def preflight(delay: float=5,_connection=None):
+    if not math.isfinite(delay):return False
+    install()
+    def work():
+        def target():
+            import services
+            sim=services.get_active_sim()
+            if sim is None:raise RuntimeError('Load a household first')
+            return float(sim.position.x),float(sim.position.z),int(sim.level)
+        try:
+            point=_build.on_main(target)
+            if point is None:raise RuntimeError('Game target unavailable')
+            result,frame=_measure(*point)
+            # Mapping only: never call move_to, mouse, click, drag or park.
+            mapped=to_screen(*result['point']) if result['status']=='point' and frame.clear(result['point']) else None
+            _log('preflight',response=result,physical_point=mapped,window=frame.geometry)
+            text='Build coordinate check complete. No pointer movement or construction. See TS4 Access log.'
+        except Exception as exc:
+            _log('preflight-failed',error=str(exc));text='Build coordinate check failed: '+str(exc)
+        _build.core.post(lambda:speech.speak(text,explicit=True))
+    timer=threading.Timer(max(0,min(30,delay)),work);timer.daemon=True;timer.name='a11y_build_coordinate_check';timer.start()
+    sims4.commands.CheatOutput(_connection)('Read-only projection check scheduled. Close the console and keep Build Mode focused.')
+    return True
diff --git a/Scripts/tyjokr_a11y_build_helpers.py b/Scripts/tyjokr_a11y_build_helpers.py
new file mode 100644
index 0000000..c384013
--- /dev/null
+++ b/Scripts/tyjokr_a11y_build_helpers.py
@@ -0,0 +1,250 @@
+"""Narrow integration fixes for the existing house/structure helpers."""
+import contextlib
+import math
+import time
+import threading
+
+_floor_lock = threading.Lock()
+_floor_job = None
+_floor_sequence = -1
+_floor_quarantined = False
+_original_house_build = None
+_original_house_stairs = None
+_planner = None
+_house_context = threading.local()
+
+_build = None
+_coordinates = None
+
+
+def _log(kind, **data):
+    import tyjokr_a11y_speech as speech
+    import json
+    speech.log_line('build helpers: ' + json.dumps(dict(kind=kind, **data), sort_keys=True, default=str))
+
+
+def _state():
+    import services
+    import tyjokr_a11y_grid as grid
+    import tyjokr_a11y_keys as keys
+    if not _build.in_build_mode() or keys.blocking_active() or keys._editing_active:
+        raise RuntimeError('Close the game dialog before changing floors')
+    lot = services.active_lot()
+    if lot is None: raise RuntimeError('No active lot')
+    floor = None  # Camera position is not a native floor number.
+    return {'zone': int(services.current_zone_id()), 'floor': floor,
+            'center': (float(lot.center.x), float(lot.center.z)),
+            'grid': bool(grid.build_cursor()), 'owner': bool(keys._build_grid_owner)}
+
+
+def _same_world(state):
+    import services
+    import tyjokr_a11y_keys as keys
+    return (_build.in_build_mode() and int(services.current_zone_id()) == state['zone']
+            and not keys.blocking_active() and not keys._editing_active)
+
+
+def _grid_message(message):
+    import tyjokr_a11y_grid as grid
+    grid._flash(message)
+
+
+def _grid_released():
+    import tyjokr_a11y_keys as keys
+    return not keys._build_grid_owner
+
+
+def _restore_grid(state):
+    import services
+    import tyjokr_a11y_grid as grid
+    if (state['grid'] and _build.in_build_mode() and
+            int(services.current_zone_id()) == state['zone'] and grid.build_cursor()):
+        grid._flash('A11yBuildGridOn')
+        return True
+    return False
+
+
+@contextlib.contextmanager
+def _floor_input(state):
+    u = _coordinates._api()
+    sent_off = False
+    try:
+        with _coordinates.physical_context(u):
+            geometry = _coordinates.window(u)
+            if state['grid'] or state['owner']:
+                # Only release native key ownership. Preserve the Python grid's
+                # tile, height, room focus, orientation and enabled setting.
+                sent_off = True
+                _build.on_main(_grid_message, 'A11yBuildGridOff')
+                # A fresh native request is an ordered UI round trip after Off.
+                # It does not move any cursor or click. Never inject a floor key
+                # before the native guard and script owner have both released.
+                _coordinates._measure(state['center'][0], state['center'][1], state['floor'])
+                deadline = time.monotonic() + 2.0
+                while not _build.on_main(_grid_released):
+                    if time.monotonic() >= deadline: raise RuntimeError('Grid ownership did not release')
+                    time.sleep(.02)
+                _log('floor-ownership-released', zone=state['zone'])
+            yield u, geometry
+    finally:
+        if sent_off:
+            restored = _build.on_main(_restore_grid, state)
+            _log('floor-ownership-restored', zone=state['zone'], restored=bool(restored))
+
+
+def _receive_floor(zone, sequence, status, current, minimum, maximum):
+    """Simulation-thread reply from the single native ControlPanel definer."""
+    global _floor_sequence
+    job = _floor_job
+    if job is None or job['done'].is_set() or str(zone) != str(job['zone']): return
+    if isinstance(sequence, bool) or not isinstance(sequence, int) or sequence <= _floor_sequence: return
+    _floor_sequence = sequence
+    if status != 'ok':
+        job['error'] = 'Native floor query: ' + str(status)
+    elif (any(isinstance(v, bool) or not isinstance(v, int) for v in (current, minimum, maximum))
+          or not -64 <= minimum <= current <= maximum <= 64):
+        job['error'] = 'Invalid native floor bounds'
+    else:
+        job['result'] = {'floor': current, 'minimum': minimum, 'maximum': maximum}
+    job['done'].set()
+
+
+def _native_floor(state, timeout=3.0):
+    """One outstanding read-only query; quarantine after timeout, never reuse late replies."""
+    global _floor_job, _floor_quarantined
+    if _floor_quarantined: raise RuntimeError('Native floor channel timed out; restart the game before retrying')
+    if not _floor_lock.acquire(False): raise RuntimeError('Another native floor query is active')
+    try:
+        job = {'zone': state['zone'], 'done': threading.Event()}
+        _floor_job = job
+        def send():
+            if not _same_world(state): raise RuntimeError('Build context changed before the native query')
+            _build._send_ui('A11yNativeFloorQuery')
+            return True
+        if _build.on_main(send) is not True:
+            _floor_quarantined = True
+            raise RuntimeError('Native floor query could not be dispatched')
+        if not job['done'].wait(timeout):
+            _floor_quarantined = True
+            raise RuntimeError('Native floor UI did not answer; install the matching UI package')
+        if 'error' in job: raise RuntimeError(job['error'])
+        if not _build.on_main(_same_world, state): raise RuntimeError('Build context changed during the native query')
+        return job['result']
+    finally:
+        _floor_job = None
+        _floor_lock.release()
+
+
+def set_floor(level):
+    """Use BBGetLevelInfo, never camera height, to verify native floor keys."""
+    try:
+        if isinstance(level, bool) or not isinstance(level, (int, float)) or not math.isfinite(level) or int(level) != level:
+            return False
+        level = int(level)
+    except (ValueError, OverflowError):
+        return False
+    try:
+        state = _build.on_main(_state)
+        if state is None: raise RuntimeError('Simulation thread did not answer')
+        info = _native_floor(state)
+        state['floor'] = info['floor']
+        _log('floor-query', wanted=level, **info)
+        if not info['minimum'] <= level <= info['maximum']:
+            _log('floor-out-of-range', wanted=level, **info)
+            return False
+        if state['floor'] == level: return True
+        with _floor_input(state) as (u, geometry):
+            for _ in range(abs(level - state['floor'])):
+                if _coordinates.window(u) != geometry or not _build.on_main(_same_world, state):
+                    raise RuntimeError('Game focus, window or Build context changed')
+                if not _build.on_main(_grid_released): raise RuntimeError('The grid reclaimed the floor keys')
+                if any(u.GetAsyncKeyState(key) & 0x8000 for key in (16,17,18,91,92)):
+                    raise RuntimeError('Release modifier keys before changing floors')
+                current = _native_floor(state)['floor']
+                if current == level: return True
+                step = 1 if current < level else -1
+                key, scan = (33, 0x49) if step > 0 else (34, 0x51)
+                if (not _build.on_main(_same_world, state) or _coordinates.window(u) != geometry
+                        or u.GetAsyncKeyState(key) & 0x8000):
+                    raise RuntimeError('Input context changed before the floor key')
+                pressed = False
+                try:
+                    u.keybd_event(key, scan, 1, 0); pressed = True
+                    time.sleep(.05)
+                finally:
+                    if pressed: u.keybd_event(key, scan, 3, 0)
+                actual = current
+                # Wait for one key acknowledgement; never stack unacknowledged keys.
+                for poll in range(30):
+                    time.sleep(.1)
+                    if _coordinates.window(u) != geometry or not _build.on_main(_same_world, state):
+                        raise RuntimeError('Build context changed while waiting for the floor')
+                    actual = _native_floor(state)['floor']
+                    if actual != current: break
+                _log('floor-step', wanted=level, before=current, actual=actual, source='BBGetLevelInfo')
+                if actual != current + step: return False
+                if actual == level: return True
+            return False
+    except Exception as exc:
+        _log('floor-refused', wanted=level, error=str(exc))
+        return False
+
+
+def _house_build(plan):
+    """Scope stacked stairs to the running plan, even after a failed room."""
+    planner = _planner
+    if planner is None: return _original_house_build(plan)
+    _house_context.transitions = tuple(getattr(plan, '_a11y_transitions', ()))
+    planner._pending_stairs = []
+    try:
+        return _original_house_build(plan)
+    finally:
+        planner._pending_stairs = []
+        _house_context.transitions = ()
+
+
+def _stairs_for_plan(top, climb):
+    planner = _planner
+    transitions = getattr(_house_context, 'transitions', ())
+    if planner is None or not transitions: return _original_house_stairs(top, climb)
+    for stair_top, stair_climb, lower, upper in transitions:
+        result = planner._place_stair_at(stair_top, stair_climb, lower)
+        _log('stair-transition', lower=lower, upper=upper, result=result)
+        if result is not True: return result
+    return True
+
+
+def _build_menu():
+    import tyjokr_a11y_plus_build as build
+    return build.open_menu()
+
+
+def install():
+    global _build, _coordinates, _original_house_build, _original_house_stairs, _planner
+    import tyjokr_a11y_plus_build as build
+    import tyjokr_a11y_plus_core as core
+    import tyjokr_a11y_build_coordinates as coordinates
+    if getattr(build, '_helper_integration_installed', False): return
+    import sims4.commands
+    import tyjokr_a11y_plus_house as house
+    def receive(zone: str='', sequence: int=0, status: str='', current: int=0, minimum: int=0, maximum: int=0, _connection=None):
+        _receive_floor(zone, sequence, status, current, minimum, maximum)
+    sims4.commands.Command('a11y.floor_native', command_type=sims4.commands.CommandType.Live)(receive)
+    try:
+        import tyjokr_a11y_house_planner as planner
+    except ImportError:
+        planner = None
+    _planner = planner
+    _original_house_stairs = planner._original_stairs if planner is not None else house.place_stairs_worker
+    _original_house_build = house._build
+    house._build = _house_build
+    house.place_stairs_worker = _stairs_for_plan
+    _build, _coordinates = build, coordinates
+    build.set_floor = set_floor
+    # Roof tools registered Alt+B before the detached wrapper loaded. Resolve
+    # the final menu when invoked, so every later wrapper is included once.
+    current = core.HOTKEYS.get(ord('B'))
+    if current is not None:
+        core.HOTKEYS[ord('B')] = (_build_menu, current[1])
+    build._helper_integration_installed = True
+    _log('installed')
diff --git a/Scripts/tyjokr_a11y_chair_snap.py b/Scripts/tyjokr_a11y_chair_snap.py
new file mode 100644
index 0000000..ca9abf9
--- /dev/null
+++ b/Scripts/tyjokr_a11y_chair_snap.py
@@ -0,0 +1,236 @@
+"""Dining/desk chair snapping through native Build/Buy attachment slots.
+
+No guessed chair offsets or rotation, no input polling and no game actions
+until the ordinary placement acknowledgement/ownership/payment transaction.
+"""
+import math
+import tyjokr_a11y_speech as speech
+
+CHAIRS = {'buycatssdiningchair': 'buycatssdiningtable',
+          'buycatssdeskchair': 'buycatssdesk'}
+MAX_SLOTS = 128
+
+
+def _log(text):
+    speech.log_line('chair snap: '+text)
+
+
+def _tags(definition):
+    from tag import Tag
+    result=set()
+    try:values=definition.get_tags() or ()
+    except (AttributeError,TypeError):return result
+    for value in values:
+        try:result.add(str(Tag(value).name).lower().replace('_',''))
+        except (ValueError,TypeError,AttributeError):pass
+    return result
+
+
+def _kind(item):
+    import services
+    import tyjokr_a11y_settings as settings
+    if not settings.get('chair_snapping', True):return None
+    try:
+        definition=services.definition_manager().get(item['id'], get_fallback_definition_id=False)
+        tags=_tags(definition)
+        for chair,table in CHAIRS.items():
+            if chair in tags:return definition,table
+    except Exception as exc:
+        _log('classification unavailable: {!r}'.format(exc))
+    return None
+
+
+def _root(obj):
+    for _ in range(8):
+        if not getattr(obj,'is_part',False):return obj
+        obj=getattr(obj,'part_owner',None)
+        if obj is None:return None
+    return None
+
+
+def _state(obj):
+    p,q=obj.position,obj.orientation
+    values=tuple(float(v) for v in (p.x,p.y,p.z,q.x,q.y,q.z,q.w))
+    if not all(math.isfinite(v) for v in values):raise ValueError('Non-finite table transform')
+    return int(obj.level),values
+
+
+def _slot_state(slot):
+    p,q=slot.position,slot.transform.orientation
+    values=tuple(float(v) for v in (p.x,p.y,p.z,q.x,q.y,q.z,q.w))
+    if not all(math.isfinite(v) for v in values):raise ValueError('Non-finite seat transform')
+    return values
+
+
+def _safe_target(obj, level):
+    import services
+    import tyjokr_a11y_place as place
+    try:
+        return (obj is not None and not getattr(obj,'is_part',False)
+                and int(obj.level)==int(level) and not obj.is_in_inventory() and not obj.is_hidden()
+                and obj.get_household_owner_id() in (None,0,place._household_id())
+                and services.active_lot().is_position_on_lot(obj.position))
+    except (AttributeError,TypeError,ValueError):return False
+
+
+def _target(item, frame):
+    import tyjokr_a11y_grid as grid
+    import tyjokr_a11y_layers as layers
+    import tyjokr_a11y_tiles as tiles
+    kind=_kind(item)
+    if kind is None:return None
+    definition,wanted=kind
+    focused=layers.focused_target()
+    if focused is not None and wanted in _tags(focused.definition) and _safe_target(focused,grid._level):
+        return definition,focused,True
+    i,j=grid._tile
+    candidates={}
+    for di in range(-1,2):
+        for dj in range(-1,2):
+            if not frame.inside(i+di,j+dj):continue
+            if di or dj:
+                side=(1 if di>0 else 3) if abs(di)>abs(dj) else (0 if dj>0 else 2)
+                if int(grid._facing)%4 != side:continue
+            for obj in tiles.objects_on(frame,i+di,j+dj,grid._level):
+                if not _safe_target(obj,grid._level) or wanted not in _tags(obj.definition):continue
+                row=(di*di+dj*dj,obj)
+                if obj.id not in candidates or row[0]<candidates[obj.id][0]:candidates[obj.id]=row
+    rows=sorted(candidates.values(),key=lambda row:(row[0],row[1].id))
+    if not rows:return None
+    if len(rows)>1 and rows[0][0]==rows[1][0]:return definition,None,False
+    return definition,rows[0][1],False
+
+
+def _slots(table):
+    # The native SlotComponent yields part-owned slots and may also yield the
+    # root-owned version of the same bone. Prefer the actual table part.
+    found={}
+    for index,slot in enumerate(table.get_runtime_slots_gen()):
+        if index>=MAX_SLOTS:raise ValueError('Too many attachment slots to check safely')
+        if _root(slot.owner) is not table:continue
+        key=int(slot.slot_name_hash)
+        if key not in found or getattr(slot.owner,'is_part',False):found[key]=slot
+    return list(found.values())
+
+
+def _key(slot):
+    owner=slot.owner
+    return int(slot.slot_name_hash),(int(owner.part_group_index) if getattr(owner,'is_part',False) else None)
+
+
+def _seat(table, definition, point, obj=None, key=None):
+    ranked=[]
+    for slot in _slots(table):
+        try:
+            if key is not None and _key(slot)!=tuple(key):continue
+            if not slot.is_enabled or not slot.empty or slot.is_deco_slot():continue
+            p=slot.position
+            distance=(float(p.x)-float(point.x))**2+(float(p.z)-float(point.z))**2
+            if not math.isfinite(distance):continue
+            ranked.append((distance,_key(slot),slot))
+        except Exception as exc:_log('slot metadata refused: {!r}'.format(exc))
+    for _distance,_ident,slot in sorted(ranked,key=lambda row:(row[0],row[1][0])):
+        try:
+            valid=(slot.is_valid_for_placement(definition=definition) if obj is None
+                   else slot.is_valid_for_placement(obj=obj))
+            _log('table {} slot {} native validation={!r}'.format(table.id,_key(slot),valid))
+            if valid:return slot
+        except Exception as exc:_log('native slot check failed: {!r}'.format(exc))
+    return None
+
+
+def _request(item, frame):
+    import services
+    import tyjokr_a11y_grid as grid
+    import tyjokr_a11y_layers as layers
+    import tyjokr_a11y_tiles as tiles
+    target=_target(item,frame)
+    if target is None:return None,None
+    definition,table,explicit=target
+    if table is None:return None,'More than one table is equally close. Focus the intended table with 1 first.'
+    point=tiles.position(frame,*grid._tile,grid._level)
+    slot=_seat(table,definition,point)
+    if slot is None:return None,'The table has no free compatible chair seat that the game accepts. Nothing was bought.'
+    focused=layers.focused_target()
+    request={'zone':int(services.current_zone_id()),'product':int(item['id']),
+             'table':int(table.id),'definition':int(table.definition.id),'state':_state(table),'slot':_key(slot),'slot_state':_slot_state(slot),
+             'tile':tuple(grid._tile),'level':int(grid._level),'facing':int(grid._facing),
+             'focused':getattr(focused,'id',None),'seat_tile':tuple(frame.tile_of(slot.position.x,slot.position.z))}
+    return request,None
+
+
+def try_place(item, frame):
+    """None delegates ordinary placement; bool means the chair path handled it."""
+    import tyjokr_a11y_grid as grid
+    import tyjokr_a11y_place as place
+    try:
+        request,error=_request(item,frame)
+        if request is None and error is None:return None
+        if error:
+            speech.speak(error,explicit=True);return False
+        target=grid.cursor()
+        if target is None:return False
+        return place.place(target[0],grid._level,grid._surface(),chair_request=request)
+    except Exception as exc:
+        _log('request refused: {!r}'.format(exc))
+        speech.speak('The chair seat could not be checked. Nothing was bought.',explicit=True)
+        return False
+
+
+def validate(request, obj, item, position, level):
+    """Recheck exact target/slot after the native tool-drop acknowledgement."""
+    import services
+    import tyjokr_a11y_grid as grid
+    import tyjokr_a11y_layers as layers
+    try:
+        if (request['zone']!=int(services.current_zone_id()) or request['product']!=int(item['id'])
+                or request['tile']!=tuple(grid._tile) or request['level']!=int(grid._level)
+                or request['facing']!=int(grid._facing) or int(level)!=request['level']
+                or request['focused']!=getattr(layers.focused_target(),'id',None)):return None
+        kind=_kind(item)
+        if kind is None:return None
+        table=services.object_manager().get(request['table'])
+        if not _safe_target(table,level) or _state(table)!=request['state'] or int(table.definition.id)!=request['definition']:return None
+        if kind[1] not in _tags(table.definition):return None
+        slot=_seat(table,kind[0],position,obj=obj,key=request['slot'])
+        if slot is not None and _slot_state(slot)==request['slot_state']:return table,slot
+    except Exception as exc:_log('acknowledged seat refused: {!r}'.format(exc))
+    return None
+
+
+def attached(table,slot,obj):
+    try:
+        hashed=getattr(obj.location,'slot_hash',None) or getattr(obj.location,'joint_name_hash',None)
+        return (_root(obj.parent) is table and int(hashed)==int(slot.slot_name_hash)
+                and any(child is obj for child in slot.children))
+    except Exception as exc:
+        _log('attachment readback failed: {!r}'.format(exc));return False
+
+
+def fit_parts(item,frame):
+    """Describe the same native seat Enter will request, without creating it."""
+    try:
+        request,error=_request(item,frame)
+        if error:return [error.replace(' Nothing was bought.','')+' ']
+        if request is not None:
+            import services
+            import tyjokr_a11y_grid as grid
+            import tyjokr_a11y_tiles as tiles
+            table=services.object_manager().get(request['table'])
+            di,dj=request['seat_tile'][0]-grid._tile[0],request['seat_tile'][1]-grid._tile[1]
+            return ['Chair will snap at ',grid._name(table),'. Seat ',tiles.relative(di,dj),'. Enter places it using the game’s validation. ']
+    except Exception as exc:_log('preview unavailable: {!r}'.format(exc))
+    return None
+
+
+def has_target(item,frame):
+    try:return _target(item,frame) is not None
+    except Exception:return False
+
+
+def announce(obj,item,price,table):
+    import tyjokr_a11y_grid as grid
+    import tyjokr_a11y_scanner as scanner
+    scanner._speak_parts(['Placed ',item.get('name') or 'chair',' at ',grid._name(table),
+                          ' using the game’s chair slot, for {} simoleons.'.format(price)])
+    _log('attached chair {} to table {} and paid {}'.format(obj.id,table.id,price))
diff --git a/Scripts/tyjokr_a11y_cleanliness.py b/Scripts/tyjokr_a11y_cleanliness.py
new file mode 100644
index 0000000..79483d5
--- /dev/null
+++ b/Scripts/tyjokr_a11y_cleanliness.py
@@ -0,0 +1,43 @@
+"""Read-only scanner suffixes for native dirt/dust states verified in-game.
+
+Only reads current state values at announcement time. No interaction tests,
+state writes, scan refreshes, object filtering or cached dirtiness.
+"""
+from itertools import islice
+import tyjokr_a11y_lang as lang
+import tyjokr_a11y_speech as speech
+
+_errors_logged = 0
+
+
+def suffix(entry):
+    global _errors_logged
+    if entry.is_sim:
+        return ''
+    try:
+        import services
+        obj = services.object_manager().get(entry.obj_id)
+        component = getattr(obj, 'state_component', None)
+        if component is None:
+            return ''
+        current = {}
+        for value in islice(component.values(), 64):
+            state_id = getattr(getattr(value, 'state', None), 'guid64', None)
+            if state_id in (15129, 15128, 255045):
+                current[state_id] = getattr(value, 'guid64', None)
+        # DirtyState is the visual state. Prefer it over the linked dirtiness
+        # commodity's state when both exist, including transient disagreement.
+        dirty = (current[15129] == 15131 if 15129 in current else current.get(15128) == 15133)
+        terms = []
+        if dirty:
+            terms.append(lang.t('scanner dirty'))
+        if current.get(255045) == 255050:
+            terms.append(lang.t('scanner dusty'))
+        return ''.join(', ' + term for term in terms)
+    except Exception as exc:
+        # A malformed/removed object must not interrupt scanner navigation.
+        # Bound failure logging rather than reporting every repeated keypress.
+        if _errors_logged < 5:
+            _errors_logged += 1
+            speech.log_line('cleanliness: state read failed for {}: {}'.format(entry.obj_id, type(exc).__name__))
+        return ''
diff --git a/Scripts/tyjokr_a11y_display_diagnostic.py b/Scripts/tyjokr_a11y_display_diagnostic.py
new file mode 100644
index 0000000..a6fdf16
--- /dev/null
+++ b/Scripts/tyjokr_a11y_display_diagnostic.py
@@ -0,0 +1,217 @@
+"""Read-only Windows/build coordinate diagnostics; never inject input or set DPI."""
+import ctypes
+import json
+import math
+import os
+import threading
+import time
+import sims4.commands
+import tyjokr_a11y_speech as speech
+
+class POINT(ctypes.Structure):
+    _fields_ = [('x', ctypes.c_int32), ('y', ctypes.c_int32)]
+
+class RECT(ctypes.Structure):
+    _fields_ = [(n, ctypes.c_int32) for n in ('left', 'top', 'right', 'bottom')]
+
+_timer = None
+_window_start = 0.0
+_count = 0
+_lock = threading.Lock()
+
+
+def _api():
+    # Private function objects: do not overwrite prototypes cached by the
+    # existing mouse worker. HWND/context return values must be pointer-wide.
+    u = ctypes.WinDLL('user32', use_last_error=True)
+    ptr, integer = ctypes.c_void_p, ctypes.c_int32
+    signatures = {
+        'GetForegroundWindow': (ptr, []),
+        'GetWindowThreadProcessId': (ctypes.c_uint32, [ptr, ctypes.POINTER(ctypes.c_uint32)]),
+        'GetClientRect': (integer, [ptr, ctypes.POINTER(RECT)]),
+        'GetWindowRect': (integer, [ptr, ctypes.POINTER(RECT)]),
+        'ClientToScreen': (integer, [ptr, ctypes.POINTER(POINT)]),
+        'ScreenToClient': (integer, [ptr, ctypes.POINTER(POINT)]),
+        'GetCursorPos': (integer, [ctypes.POINTER(POINT)]),
+        'GetPhysicalCursorPos': (integer, [ctypes.POINTER(POINT)]),
+        'LogicalToPhysicalPointForPerMonitorDPI': (integer, [ptr, ctypes.POINTER(POINT)]),
+        'GetDpiForWindow': (ctypes.c_uint32, [ptr]),
+        'GetThreadDpiAwarenessContext': (ptr, []),
+        'GetWindowDpiAwarenessContext': (ptr, [ptr]),
+        'GetAwarenessFromDpiAwarenessContext': (integer, [ptr]),
+        'GetSystemMetrics': (integer, [integer]),
+        'MonitorFromWindow': (ptr, [ptr, ctypes.c_uint32]),
+        'GetWindowLongPtrW': (ctypes.c_ssize_t, [ptr, integer]),
+        'IsZoomed': (integer, [ptr]),
+        'IsIconic': (integer, [ptr]),
+    }
+    for name, (result, args) in signatures.items():
+        fn = getattr(u, name, None)
+        if fn is not None:
+            fn.restype, fn.argtypes = result, args
+    return u
+
+
+def _monitor_scale(u, hwnd):
+    monitor = u.MonitorFromWindow(hwnd, 2)
+    if not monitor: raise RuntimeError('monitor unavailable')
+    lib = ctypes.WinDLL('shcore', use_last_error=True)
+    fn = lib.GetScaleFactorForMonitor
+    fn.argtypes = [ctypes.c_void_p, ctypes.POINTER(ctypes.c_int32)]
+    fn.restype = ctypes.c_int32
+    scale = ctypes.c_int32()
+    if fn(monitor, ctypes.byref(scale)) != 0: raise RuntimeError('scale unavailable')
+    return int(scale.value)
+
+
+def windows_snapshot(u=None):
+    u = _api() if u is None else u
+    hwnd = u.GetForegroundWindow()
+    owner = ctypes.c_uint32()
+    if not hwnd or not u.GetWindowThreadProcessId(hwnd, ctypes.byref(owner)) or owner.value != os.getpid():
+        return {'refused': 'foreground window is not owned by this game process'}
+    result = {'hwnd': int(hwnd), 'thread': threading.current_thread().name,
+              'game_ui_stage_size': None, 'errors': {}}
+    def field(name, fn):
+        try: result[name] = fn()
+        except Exception as exc: result['errors'][name] = type(exc).__name__
+    def rect(fn):
+        r = RECT()
+        if not fn(hwnd, ctypes.byref(r)): raise RuntimeError('rectangle query failed')
+        return [r.left, r.top, r.right, r.bottom]
+    def point(fn, initial=(0, 0), window=True):
+        p = POINT(*initial)
+        args = (hwnd, ctypes.byref(p)) if window else (ctypes.byref(p),)
+        if not fn(*args): raise RuntimeError('point query failed')
+        return [p.x, p.y]
+    field('client_rect_reported', lambda: rect(u.GetClientRect))
+    field('window_rect_reported', lambda: rect(u.GetWindowRect))
+    field('client_origin_reported', lambda: point(u.ClientToScreen))
+    field('cursor_reported', lambda: point(u.GetCursorPos, window=False))
+    field('cursor_physical', lambda: point(u.GetPhysicalCursorPos, window=False))
+    field('window_dpi', lambda: int(u.GetDpiForWindow(hwnd)))
+    field('monitor_scale_percent', lambda: _monitor_scale(u, hwnd))
+    field('window_style_hex', lambda: hex(u.GetWindowLongPtrW(hwnd, -16) & 0xffffffff))
+    field('maximized', lambda: bool(u.IsZoomed(hwnd)))
+    field('minimized', lambda: bool(u.IsIconic(hwnd)))
+    field('thread_awareness', lambda: int(u.GetAwarenessFromDpiAwarenessContext(u.GetThreadDpiAwarenessContext())))
+    field('window_awareness', lambda: int(u.GetAwarenessFromDpiAwarenessContext(u.GetWindowDpiAwarenessContext(hwnd))))
+    field('primary_size_reported', lambda: [u.GetSystemMetrics(0), u.GetSystemMetrics(1)])
+    field('virtual_desktop_reported', lambda: [u.GetSystemMetrics(i) for i in (76, 77, 78, 79)])
+    r = result.get('client_rect_reported')
+    if r:
+        w, h = r[2] - r[0], r[3] - r[1]
+        result['client_size_reported'] = [w, h]
+        samples = []
+        for initial in ((0, 0), (w // 2, h // 2), (max(0,w-1), max(0,h-1))):
+            sample = {'client': list(initial)}
+            try:
+                screen = point(u.ClientToScreen, initial)
+                sample.update(screen_reported=screen, client_roundtrip=point(u.ScreenToClient, screen))
+                sample['screen_physical_for_window'] = point(u.LogicalToPhysicalPointForPerMonitorDPI, screen)
+            except Exception as exc: sample['error'] = type(exc).__name__
+            samples.append(sample)
+        result['samples'] = samples
+    if u.GetForegroundWindow() != hwnd:
+        return {'refused': 'foreground changed during capture'}
+    return result
+
+
+def saved_options():
+    # Read only display fields, with a size cap; never include unrelated
+    # preferences, paths or personal data from Options.ini in the log.
+    result = {}
+    try:
+        folder = os.path.dirname(speech.LOG_PATH)
+        for _ in range(3):
+            if os.path.basename(folder).lower() == 'mods':
+                root = os.path.dirname(folder)
+                break
+            folder = os.path.dirname(folder)
+        else:
+            raise ValueError('Mods root unavailable')
+        with open(os.path.join(root, 'Options.ini'), 'r', encoding='utf-8-sig') as f:
+            text = f.read(65536)
+        keys = {'resolutionwidth','resolutionheight','resolutionrefresh','fullscreen','windowedfullscreen','uiscale','sceneresolution'}
+        for line in text.splitlines():
+            key, sep, value = line.partition('=')
+            if sep and key.strip().lower() in keys:
+                result[key.strip().lower()] = int(value.strip())
+    except Exception as exc: result['error'] = type(exc).__name__
+    return result
+
+
+def record(kind, data=None, build=None):
+    global _window_start, _count
+    if not speech.log_enabled: return False
+    with _lock:
+        now = time.monotonic()
+        if now - _window_start >= 60: _window_start, _count = now, 0
+        if _count >= 30: return False
+        _count += 1
+    try:
+        row = windows_snapshot()
+        row.update(kind=kind, data=data, saved_options=saved_options())
+        if build is not None and 'refused' not in row:
+            try: row['adapter_size_reported'] = list(build._stage_size())
+            except Exception as exc: row['errors']['adapter_size_reported'] = type(exc).__name__
+        speech.log_line('display inspect: ' + json.dumps(row, sort_keys=True, default=str))
+        return 'refused' not in row
+    except Exception as exc:
+        speech.log_line('display inspect: capture failed ' + type(exc).__name__)
+        return False
+
+
+def install(build):
+    if getattr(build, '_display_diagnostic_installed', False): return
+    original_project, original_convert = build.project, build._to_screen
+    def observe(kind, data):
+        try: record(kind, data, build)
+        except Exception: pass  # Optional logging must never break a build.
+    def project(*args, **kwargs):
+        try: result = original_project(*args, **kwargs)
+        except Exception as exc:
+            observe('project-error', {'error': type(exc).__name__, 'world_args': args})
+            raise
+        observe('project', {'world_args': args, 'world_kwargs': kwargs, 'reported_game_point': result})
+        return result
+    def convert(*args, **kwargs):
+        try: result = original_convert(*args, **kwargs)
+        except Exception as exc:
+            observe('convert-error', {'error': type(exc).__name__, 'input': args})
+            raise
+        observe('convert', {'input': args, 'output': result})
+        return result
+    build.project, build._to_screen = project, convert
+    build._display_diagnostic_installed = True
+
+
+@sims4.commands.Command('a11y.inspect_display', command_type=sims4.commands.CommandType.Live)
+def inspect_display(delay: float = 5, _connection=None):
+    global _timer
+    output = sims4.commands.CheatOutput(_connection)
+    if not math.isfinite(delay): return False
+    if not speech.log_enabled:
+        output('Run a11y.log on first.'); return False
+    try:
+        import tyjokr_a11y_plus_build as build
+        install(build)
+    except Exception as exc:
+        speech.log_line('display inspect: adapter unavailable ' + type(exc).__name__)
+        output('Display diagnostic unavailable; see TS4 Access log.')
+        return False
+    if _timer is not None: _timer.cancel()
+    delay = max(0, min(30, delay))
+    def capture():
+        try:
+            record('manual', build=build)
+        except Exception as exc:
+            speech.log_line('display inspect: manual capture failed ' + type(exc).__name__)
+    # No game APIs on this timer: only Win32/filesystem reads. Actual builder
+    # worker DPI/coordinates are captured by the passive wrappers separately.
+    _timer = threading.Timer(delay, capture)
+    _timer.daemon = True
+    _timer.name = 'a11y_display_probe'
+    _timer.start()
+    output('Read-only display snapshot in {} seconds. Close the console and keep the game focused; see TS4 Access log.'.format(delay))
+    return True

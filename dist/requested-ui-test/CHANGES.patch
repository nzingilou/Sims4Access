+  self.build=types.SimpleNamespace(on_main=lambda fn,*a:fn(*a),frame=lambda:self.frame,set_floor=Mock(return_value=True),drag=Mock(),_last_error={'text':'old message','at':-1},_busy=[False],funds=lambda:10000)

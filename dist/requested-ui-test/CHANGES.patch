 In Live mode the grid only reads the lot. It does not place objects.
 
+EXPERIMENTAL BASEMENTS
+
+Alt+B, Basement assistant (experimental): build a rectangular basement room
+or inspect native floor bounds and existing basement rooms without building.
+Choose the size and position, then confirm before any construction.
+Stacked-house plans with a basement use this adapter automatically.
+Accessibility settings: experimental basement creation turns it on or off.
+Each basement room is drawn from ground level with the native Basement Tool;
+its floor, complete rectangular footprint and unchanged existing rooms must
+be verified before the helper continues to the next room, doors or stairs.
+
+UNIFIED HOUSE BUILDER
+
+Alt+B, Build my house: start with an original ready-made layout, design a
+square or rectangle, or choose the original room list. All routes use one
+review screen. Choose Stories and basement to repeat aligned floor layouts.
+Choose Rooms, positions and custom names to edit one room at a time.
+Descriptions give the actual compass position and street-facing/rear role.
+Construction starts only after selecting Build this house in the review.
+The separate Configurable stacked house row is replaced by this flow.
+
+
+Requested screen additions:
+Accessibility menu > Events > selected running event > Current event goals.
+Accessibility menu > Panels > Photography controls (open the camera first).
+Social Bunny: arrow/Tab through each readable card and its native action buttons.
+Book title dialogs: use Tab or Shift+Tab to leave the text field, then navigate to the native confirmation footer.
diff --git a/Scripts/tyjokr_a11y_basement.py b/Scripts/tyjokr_a11y_basement.py
new file mode 100644
index 0000000..4715055
--- /dev/null
+++ b/Scripts/tyjokr_a11y_basement.py
@@ -0,0 +1,335 @@
+"""Experimental native basement drawing, isolated from ordinary room workers."""
+import configparser
+import math
+import threading
+import time
+
+_build = None
+_core = None
+_helpers = None
+_original_room = None
+_original_menu = None
+_original_reply = None
+_original_render = None
+_selection = None
+_failure = threading.local()
+SETTING = 'experimental_basement'
+TOOL = 'Basement Tool'
+
+
+def _log(kind, **data):
+    import json
+    import tyjokr_a11y_speech as speech
+    speech.log_line('basement adapter: ' + json.dumps(dict(kind=kind, **data), sort_keys=True, default=str))
+
+
+def _enabled():
+    import tyjokr_a11y_settings as settings
+    return bool(settings.get(SETTING, True))
+
+
+def _context():
+    import services
+    state = _helpers._state()
+    state['household'] = int(services.active_household_id())
+    return state
+
+
+def _same_context(state):
+    import services
+    return (_enabled() and _helpers._same_world(state)
+            and int(services.active_household_id()) == state['household'])
+
+
+def _rooms():
+    result = _build._room_ids()
+    if result is None: raise RuntimeError('The game did not supply its room geometry')
+    return {(tuple(box), int(level)) for box, level in result}
+
+
+def _overlap(a, b):
+    return max(a[0], b[0]) < min(a[2], b[2]) and max(a[1], b[1]) < min(a[3], b[3])
+
+
+def _bounds(want, frame):
+    if len(want) != 4 or any(isinstance(v, bool) or not isinstance(v, (int,float))
+            or not math.isfinite(v) or int(v) != v for v in want):
+        raise ValueError('Basement corners must be four whole-metre coordinates')
+    box = tuple(int(v) for v in want)
+    if not (1 <= box[0] < box[2] <= frame.width-1 and 1 <= box[1] < box[3] <= frame.depth-1):
+        raise ValueError('The basement must fit at least one metre inside the lot')
+    return box
+
+
+def _reply(encoded=''):
+    # Leave all existing catalog, placement and scanner reply behavior intact.
+    result = _original_reply(encoded)
+    job = _selection
+    if job is not None:
+        try:
+            from urllib.parse import unquote
+            parts = unquote(str(encoded or '')).split('|')
+            if (len(parts) == 3 and parts[0] == 'selected'
+                    and parts[1] == str(job['index']) and unquote(parts[2]) == job['name']
+                    and _build._cat['serial'] == job['serial']):
+                job['done'].set()
+        except Exception:
+            _core.log_exc('basement tool reply')
+    return result
+
+
+def _tool(name, state):
+    global _selection
+    if not _build.on_main(_same_context, state): return False
+    # The native bridge replaces its catalog array. An old index must never
+    # reselect an unrelated tool if this query or selection is interrupted.
+    _build.on_main(_build._cat.pop, 'chosen', None)
+    items = _build.fetch_catalog(16, '', 'tool') or []
+    names = [item[0] for item in items]
+    _log('catalog', wanted=name, tools=names)
+    if name not in names or not _build.on_main(_same_context, state): return False
+    index = names.index(name)
+    job = {'index':index, 'name':name, 'serial':_build._cat['serial'], 'done':threading.Event()}
+    _selection = job
+    silent = _build._cat.get('silent_select', False)
+    try:
+        _build._cat['silent_select'] = True
+        _build.select_item(index, name)
+        acknowledged = job['done'].wait(2.0)
+        _log('tool-selection', name=name, acknowledged=acknowledged)
+        return acknowledged and bool(_build.on_main(_same_context, state))
+    finally:
+        _selection = None
+        _build._cat['silent_select'] = silent
+
+
+def _check_result(before, after, wanted):
+    target = (wanted, -1)
+    # A bounding box alone cannot count a ground-floor room as a basement.
+    return target in after-before and before.issubset(after) and after-before == {target}
+
+
+def _rectangle(wanted):
+    import tyjokr_a11y_plus_rooms as rooms
+    frame = _build.frame()
+    matches = [r for r in rooms.scan_rooms() if int(r.level) == -1 and _build._room_box(r) == wanted]
+    if len(matches) != 1: return False
+    actual = {(int(math.floor(frame.local(x,z)[0])), int(math.floor(frame.local(x,z)[1]))) for x,z in matches[0].tiles}
+    expected = {(x,z) for x in range(wanted[0],wanted[2]) for z in range(wanted[1],wanted[3])}
+    return actual == expected
+
+
+def _draw(want, overview):
+    state = _build.on_main(_context)
+    if not state: raise RuntimeError('The simulation thread did not answer')
+    frame = _build.on_main(_build.frame)
+    if frame is None: raise RuntimeError('The lot geometry is unavailable')
+    wanted = _bounds(want, frame)
+    before = _build.on_main(_rooms)
+    if before is None: raise RuntimeError('Room inspection timed out')
+    if any(level == -1 and _overlap(box,wanted) for box,level in before):
+        _log('occupied', wanted=wanted)
+        return 'occupied'
+    if not _build.set_floor(0): return 'nofloor'
+    selected = False
+    attempted = False
+    result = 'nocatalog'
+    restore_ok = True
+    try:
+        attempted = True
+        selected = _tool(TOOL, state)
+        if not selected:
+            _core.post(_core.speak, 'The native Basement Tool was not confirmed. Nothing was drawn. Its catalog entries were logged.')
+            return 'nocatalog'
+        points = [frame.world(wanted[0],wanted[1]), frame.world(wanted[2],wanted[3])]
+        started = time.monotonic()
+        funds_before = _build.on_main(_build.funds)
+        def action(screen):
+            if not _build.on_main(_same_context,state): raise RuntimeError('Build context changed before the basement drag')
+            if not _tool(TOOL,state): raise RuntimeError('The Basement Tool could not be confirmed after camera preparation')
+            info = _helpers._native_floor(state)
+            if info['floor'] != 0: raise RuntimeError('The game is no longer showing the ground floor')
+            _log('drag', wanted=wanted, input_floor=0, expected_floor=-1, native_floor=info)
+            _build.drag(screen[0],screen[1])
+        performed = _build.point_and_act(points,0,action,'experimental basement {}'.format(wanted),overview=overview)
+        if not performed: return 'noscreen'
+        _log('after-drag', native_floor=_helpers._native_floor(state), funds_before=funds_before, funds_after=_build.on_main(_build.funds))
+        after = before
+        for attempt in range(20):
+            if not _build.on_main(_same_context,state): raise RuntimeError('Build context changed while checking the basement')
+            after = _build.on_main(_rooms)
+            if after is None: raise RuntimeError('Basement verification timed out')
+            if after != before: break
+            time.sleep(.25)
+        okay = _check_result(before,after,wanted) and bool(_build.on_main(_rectangle,wanted))
+        error = _build._last_error
+        reason = error.get('text','') if error.get('at',0) >= started else ''
+        _log('verification', wanted=wanted, expected_floor=-1, new=sorted(after-before),
+             removed=sorted(before-after), success=okay, game_reason=reason)
+        result = wanted if okay else 'unverified'
+        if not okay:
+            _core.post(_core.speak, 'Basement construction stopped: the game did not confirm the requested room on floor minus one.'
+                       + (' Game message: '+reason if reason else '') + ' Inspect the result before using Undo or trying again.')
+    finally:
+        # Never leave Basement Tool selected for the next above-ground room.
+        if attempted:
+            if _build.on_main(_same_context,state): restore_ok = _tool('Room Tool',state)
+            else: restore_ok = False
+            _log('restore-room-tool', success=restore_ok)
+    if not restore_ok:
+        _core.post(_core.speak,'The basement step stopped because the ordinary Room Tool could not be restored.')
+        return 'nocatalog'
+    return result
+
+
+def failure_reason():
+    return getattr(_failure,'reason','')
+
+
+def room_worker(want, overview=False, tries=4, level=0):
+    _failure.reason = ''
+    if level != -1:
+        return _original_room(want,overview=overview,tries=tries,level=level)
+    if not _enabled():
+        _core.post(_core.speak,'Experimental basement creation is off in accessibility settings.')
+        result = 'disabled'
+    else:
+        try:
+            result = _draw(want,overview)
+        except Exception as exc:
+            _log('stopped', wanted=want, error=str(exc))
+            _core.post(_core.speak,'Basement construction stopped. '+str(exc))
+            result = 'unverified'
+    if result != tuple(want):
+        _failure.reason = {'disabled':'experimental basement creation is turned off',
+                          'occupied':'the requested footprint overlaps an existing basement room',
+                          'nofloor':'the game could not reach the ground floor for the basement tool',
+                          'nocatalog':'the required native tool selection was not confirmed',
+                          'noscreen':'the corners could not be framed clear of the interface'}.get(result,'the requested room on floor minus one could not be verified')
+    return result
+
+
+def _start_room(wanted):
+    if _build._busy[0]:
+        _core.speak('Still working on the last build step.'); return
+    if not _enabled():
+        _core.speak('Turn on experimental basement creation in accessibility settings first.'); return
+    _build._busy[0] = True
+    _core.speak('Building the basement room. Please do not press keys until it finishes.')
+    def work():
+        try:
+            result = room_worker(wanted,overview=True,level=-1)
+            if result == wanted:
+                shown = _build.set_floor(-1)
+                _core.post(_core.speak,'The basement room was verified on floor minus one. '
+                           + ('The game now shows the basement.' if shown else 'The room exists, but the game could not switch to its floor.'))
+            else:
+                _core.post(_core.speak,'The basement room was not completed: {}. No further rooms were attempted.'.format(result))
+        finally:
+            _build._busy[0] = False
+    try: threading.Thread(target=work,name='a11y_basement_room',daemon=True).start()
+    except Exception:
+        _build._busy[0] = False
+        raise
+
+
+def _ask_room():
+    def size(text):
+        values = _build._numbers(text)
+        if len(values) != 2 or any(v < 1 or v > 30 for v in values):
+            _core.speak('Type a width and depth between 1 and 30 metres.'); return
+        width,depth = values
+        def position(text):
+            coords = _build._numbers(text)
+            if len(coords) != 2:
+                _core.speak('Type meters from west and north, for example 2 3.'); return
+            wanted = (coords[0],coords[1],coords[0]+width,coords[1]+depth)
+            try: _bounds(wanted,_build.frame())
+            except ValueError as exc: _core.speak(str(exc)); return
+            rows=[('Build this basement room','Uses the native tool and spends household funds only if the game accepts it.',True),('Cancel',None,False)]
+            _core.choose('Confirm experimental basement','{} by {} metres, {} from west and {} from north. Floor minus one. Existing basement rooms must not overlap this footprint.'.format(width,depth,*coords),rows,
+                         lambda yes:_start_room(wanted) if yes else None,tag='build')
+        _core.ask_text('Basement position','Type meters from the west edge, then the north edge of the lot. For example 2 3.','',position)
+    _core.ask_text('Basement size','Type width west to east and depth north to south in metres, for example 4 5.','',size)
+
+
+def _inspect():
+    if _build._busy[0]: _core.speak('Still working on the last build step.'); return
+    _build._busy[0] = True
+    def work():
+        try:
+            state = _build.on_main(_context)
+            info = _helpers._native_floor(state)
+            geometry = _build.on_main(_rooms)
+            if geometry is None: raise RuntimeError('Room inspection timed out')
+            basements = sorted(box for box,level in geometry if level == -1)
+            _log('inspect', basement_rooms=basements, native_floor=info)
+            _core.post(_core.speak,'Logged current floor bounds and {} basement rooms. Nothing was built or selected.'.format(len(basements)))
+        except Exception as exc:
+            _log('inspect-failed',error=str(exc)); _core.post(_core.speak,'Basement inspection failed. '+str(exc))
+        finally: _build._busy[0] = False
+    try: threading.Thread(target=work,name='a11y_basement_inspect',daemon=True).start()
+    except Exception:
+        _build._busy[0] = False; raise
+
+
+def open_assistant():
+    if not _build.in_build_mode(): _core.speak('Enter Build mode first.'); return
+    rows=[('Build a rectangular basement room','Choose size and position; verifies floor minus one before reporting success.',_ask_room),
+          ('Inspect basement floors and rooms','Read-only native-floor and room diagnostics; builds and selects nothing.',_inspect)]
+    _core.choose('Basement assistant (experimental)','Stacked houses with a basement use the same adapter automatically. Creation can be turned off in accessibility settings.',rows,lambda fn:fn(),tag='build')
+
+
+def _open_menu():
+    choose = _core.choose
+    def extended(title,prompt,rows,callback,tag=None,*args,**kwargs):
+        if title == 'Build helper':
+            rows=list(rows)+[('Basement assistant (experimental)','Build a basement room or inspect native floors and existing rooms.',open_assistant)]
+        return choose(title,prompt,rows,callback,tag,*args,**kwargs)
+    _core.choose = extended
+    try: return _original_menu()
+    finally: _core.choose = choose
+
+
+def _render(stored):
+    import tyjokr_a11y_settings as settings
+    base = _original_render(stored)
+    line = 'experimental basement = {}\n'.format('on' if stored.get(SETTING,settings.DEFAULTS[SETTING]) else 'off')
+    marker = '[contribution]\n'
+    return base.replace(marker,marker+line,1) if marker in base else base.rstrip()+'\n\n'+marker+line
+
+
+def _install_setting():
+    global _original_render
+    import tyjokr_a11y_settings as settings
+    import tyjokr_a11y_menu as menu
+    settings.DEFAULTS.setdefault(SETTING,True)
+    settings._FILE_MAP[('contribution','experimental basement')] = SETTING
+    if SETTING not in settings._BOOL_KEYS: settings._BOOL_KEYS = tuple(settings._BOOL_KEYS)+(SETTING,)
+    parser = configparser.ConfigParser(interpolation=None,strict=False,inline_comment_prefixes=(';','#'))
+    try:
+        with open(settings.PATH,'r',encoding='utf-8') as handle: parser.read_file(handle)
+        value = parser.get('contribution','experimental basement',fallback='').strip().lower()
+        if value in settings._TRUE_WORDS: settings._stored[SETTING] = True
+        elif value in settings._FALSE_WORDS: settings._stored[SETTING] = False
+    except (OSError,configparser.Error): pass
+    _original_render = settings._render
+    settings._render = _render
+    if not any(row.key==SETTING for row in menu.ROWS):
+        index = next((i for i,row in enumerate(menu.ROWS) if row.key=='reload'),len(menu.ROWS))
+        menu.ROWS.insert(index,menu.Row(SETTING,'bool','experimental basement creation',help='uses the native Basement Tool from ground level and verifies the result below'))
+        menu._SETTING_ROWS = [row for row in menu.ROWS if row.kind!='action']
+
+
+def install():
+    global _build,_core,_helpers,_original_room,_original_menu,_original_reply
+    import tyjokr_a11y_plus_build as build
+    import tyjokr_a11y_plus_core as core
+    import tyjokr_a11y_build_helpers as helpers
+    if getattr(build,'_basement_adapter_installed',False): return
+    _build,_core,_helpers = build,core,helpers
+    _install_setting()
+    _original_room,_original_menu,_original_reply = build.room_worker,build.open_menu,build._flash_reply
+    build.room_worker,build.open_menu,build._flash_reply = room_worker,_open_menu,_reply
+    build._basement_adapter_installed = True
+    _log('installed',experimental=True,enabled=_enabled())
diff --git a/Scripts/tyjokr_a11y_build_coordinates.py b/Scripts/tyjokr_a11y_build_coordinates.py
new file mode 100644
index 0000000..3e82d5c
--- /dev/null
+++ b/Scripts/tyjokr_a11y_build_coordinates.py
@@ -0,0 +1,315 @@
+"""Measured UI -> client -> physical-screen boundary for build helpers.
+
+No resolution presets or extra DPI multiplier. Native projection is read-only;
+actual clicks/drags remain the existing helpers and the game's validation.
+"""
+import contextlib
+import ctypes
+import json
+import math
+import os
+import threading
+import time
+from urllib.parse import unquote
+import sims4.commands
+import tyjokr_a11y_speech as speech
+import tyjokr_a11y_display_diagnostic as display
+
+_build = None
+_frame = None
+_serial = 0
+_pending = {}
+_lock = threading.Lock()
+_local = threading.local()
+
+
+def _log(kind, **data):
+    speech.log_line('build coordinates: ' + json.dumps(dict(kind=kind, **data), sort_keys=True, default=str))
+
+
+def _api():
+    u = display._api()
+    signatures = {
+        'SetThreadDpiAwarenessContext': (ctypes.c_void_p, [ctypes.c_void_p]),
+        'SetCursorPos': (ctypes.c_int32, [ctypes.c_int32, ctypes.c_int32]),
+        'mouse_event': (None, [ctypes.c_uint32, ctypes.c_uint32, ctypes.c_uint32, ctypes.c_uint32, ctypes.c_size_t]),
+        'GetAsyncKeyState': (ctypes.c_short, [ctypes.c_int32]),
+        'GetAncestor': (ctypes.c_void_p, [ctypes.c_void_p, ctypes.c_uint32]),
+        'keybd_event': (None, [ctypes.c_ubyte, ctypes.c_ubyte, ctypes.c_uint32, ctypes.c_size_t]),
+    }
+    for name, (result, args) in signatures.items():
+        fn = getattr(u, name)
+        fn.restype, fn.argtypes = result, args
+    return u
+
+
+@contextlib.contextmanager
+def physical_context(u):
+    previous = u.SetThreadDpiAwarenessContext(ctypes.c_void_p(-4))
+    if not previous: raise RuntimeError('Per-monitor coordinate context unavailable')
+    try: yield
+    finally:
+        if not u.SetThreadDpiAwarenessContext(previous):
+            _log('dpi-restore-failed')
+            raise RuntimeError('Thread DPI context could not be restored')
+
+
+def window(u):
+    hwnd = u.GetForegroundWindow()
+    pid = ctypes.c_uint32()
+    if not hwnd or not u.GetWindowThreadProcessId(hwnd, ctypes.byref(pid)) or pid.value != os.getpid():
+        raise RuntimeError('The game must remain focused')
+    if u.GetAncestor(hwnd,3)!=hwnd:raise RuntimeError('Close the native game dialog before building')
+    if u.IsIconic(hwnd): raise RuntimeError('The game window is minimized')
+    rect = display.RECT(); origin = display.POINT(0, 0)
+    if not u.GetClientRect(hwnd, ctypes.byref(rect)) or not u.ClientToScreen(hwnd, ctypes.byref(origin)):
+        raise RuntimeError('Game window geometry unavailable')
+    w, h = int(rect.right-rect.left), int(rect.bottom-rect.top)
+    desktop = tuple(int(u.GetSystemMetrics(i)) for i in (76,77,78,79))
+    if min(w,h,desktop[2],desktop[3]) < 100: raise RuntimeError('Invalid game window dimensions')
+    return (int(hwnd),origin.x,origin.y,w,h,int(u.GetDpiForWindow(hwnd)),desktop,
+            int(u.GetWindowLongPtrW(hwnd,-16)))
+
+
+def capture_window():
+    u = _api()
+    with physical_context(u): return window(u)
+
+
+class Frame:
+    def __init__(self, zone, width, height, mode, bounds, layout, geometry, align=''):
+        if not all(math.isfinite(v) for v in (width,height,*bounds,*layout)):
+            raise ValueError('Non-finite viewport')
+        if not (100 <= width <= 100000 and 100 <= height <= 100000): raise ValueError('Invalid viewport')
+        if mode not in ('noScale','exactFit','showAll','noBorder'): raise ValueError('Unverified stage scale mode: '+mode)
+        if mode in ('showAll','noBorder') and align not in ('','T','B','L','R','TL','TR','BL','BR','LT','RT','LB','RB'):
+            raise ValueError('Unknown stage alignment: '+repr(align))
+        if min(layout) < 100 or not (0 <= bounds[0] < bounds[2] <= layout[0] and 0 <= bounds[1] < bounds[3] <= layout[1]):
+            raise ValueError('Invalid build bounds')
+        self.zone,self.width,self.height,self.mode,self.geometry=zone,width,height,mode,geometry
+        self.sx,self.sy=geometry[3]/width,geometry[4]/height
+        self.ox=self.oy=0.0
+        if mode in ('showAll','noBorder'):
+            self.sx=self.sy=(min if mode=='showAll' else max)(self.sx,self.sy)
+            free_x,free_y=geometry[3]-width*self.sx,geometry[4]-height*self.sy
+            self.ox=0.0 if 'L' in align else free_x if 'R' in align else free_x/2
+            self.oy=0.0 if 'T' in align else free_y if 'B' in align else free_y/2
+        self.bounds=(bounds[0]*width/layout[0],bounds[1]*height/layout[1],bounds[2]*width/layout[0],bounds[3]*height/layout[1])
+    def client(self, x, y, offset=(0,0)):
+        x,y=float(x)+offset[0],float(y)+offset[1]
+        if not (math.isfinite(x) and math.isfinite(y) and 0 <= x < self.width and 0 <= y < self.height):
+            raise ValueError('Projected point is outside the game viewport')
+        result=(int(round(self.ox+x*self.sx)),int(round(self.oy+y*self.sy)))
+        if not (0<=result[0]<self.geometry[3] and 0<=result[1]<self.geometry[4]):raise ValueError('Projected point is cropped from the viewport')
+        return result
+    def clear(self,p):
+        x,y=p;left,top,right,bottom=self.bounds
+        return left <= x <= right and top <= y <= bottom and .02*self.width <= x <= .98*self.width and .08*self.height <= y <= .70*self.height
+
+
+@sims4.commands.Command('a11y.coords_enc', command_type=sims4.commands.CommandType.Live)
+def receive(text: str = '', _connection=None):
+    try:
+        if len(text)>3000:return False
+        fields=unquote(text).split('|')
+        if len(fields)!=15:return False
+        ident=int(fields[0]);zone=int(fields[1]);status=fields[2]
+        with _lock:job=_pending.get(ident)
+        if job is None or job['zone']!=zone:return False
+        if status not in ('point','viewport'):
+            job['result']={'status':status};job['event'].set();return True
+        values=[float(fields[i]) for i in (3,4,5,6,9,10,11,12,13,14)]
+        if not all(math.isfinite(v) for v in values[2:]):return False
+        if status=='point' and not all(math.isfinite(v) for v in values[:2]):return False
+        job['result']={'status':status,'zone':zone,'point':tuple(values[:2]),'width':values[2],'height':values[3],
+                       'mode':fields[7],'align':fields[8],'layout':tuple(values[4:6]),'bounds':tuple(values[6:10])}
+        job['event'].set();return True
+    except Exception as exc:
+        _log('reply-rejected',error=type(exc).__name__);return False
+
+
+def _measure(x,z,level,height=0.0,timeout=3.0):
+    global _serial,_frame
+    before=capture_window()
+    with _lock:
+        _serial=(_serial%2147483646)+1;ident=_serial
+        job={'event':threading.Event(),'zone':None,'result':None}
+        _pending[ident]=job
+    def start():
+        try:
+            import services
+            job['zone']=int(services.current_zone_id())
+            y=_build.floor_height(x,z,level)+height
+            _build._send_ui('A11y|coords|{}|{:.6f}|{:.6f}|{:.6f}|{}|{}'.format(ident,x,y,z,level,job['zone']))
+        except Exception as exc:
+            job['result']={'status':'request-error','error':type(exc).__name__};job['event'].set()
+    _build.core.post(start)
+    try:
+        if not job['event'].wait(timeout):raise RuntimeError('Projection measurement timed out; check paired UI packages')
+        result=job['result']
+        if not result or result['status'] not in ('point','viewport'):raise RuntimeError('Projection refused: '+str(result))
+        after=capture_window()
+        if before!=after:raise RuntimeError('Game window changed during projection')
+        _log('raw-measure',response=result,window=after)
+        frame=Frame(result['zone'],result['width'],result['height'],result['mode'],result['bounds'],result['layout'],after,result['align'])
+        _frame=frame
+        _log('measure',response=result,window=after)
+        return result,frame
+    finally:
+        with _lock:_pending.pop(ident,None)
+
+
+def project(x,z,level,timeout=2.5,height=0.0):
+    try:
+        result,frame=_measure(x,z,level,height,timeout=max(2.5,timeout))
+        return result['point'] if result['status']=='point' else None
+    except Exception as exc:
+        _log('project-refused',error=str(exc));return None
+
+
+def _current(u):
+    frame=getattr(_local,'input_frame',None) or _frame
+    if frame is None:raise RuntimeError('Measure the game viewport before building')
+    if window(u)!=frame.geometry:raise RuntimeError('Game focus, size, position or DPI changed; retry the operation')
+    import sys
+    keys=sys.modules.get('tyjokr_a11y_keys')
+    if keys is not None and (getattr(keys,'_editing_active',False) or keys.blocking_active()):
+        raise RuntimeError('Close the open game dialog before building')
+    return frame
+
+
+def stage_size():
+    u=_api()
+    with physical_context(u):f=_current(u);return f.width,f.height
+
+
+def to_screen(x,y):
+    u=_api()
+    with physical_context(u):
+        f=_current(u);cx,cy=f.client(x,y,_build.OFFSET)
+        point=display.POINT(cx,cy)
+        if not u.ClientToScreen(f.geometry[0],ctypes.byref(point)):raise RuntimeError('Client conversion failed')
+        _log('convert',ui=[x,y],client=[cx,cy],screen=[point.x,point.y],window=f.geometry)
+        return point.x,point.y
+
+
+def _release(u):
+    if getattr(_local,'down',False):
+        u.mouse_event(4,0,0,0,0);_local.down=False
+
+
+def move_to(x,y):
+    u=_api()
+    try:
+        with physical_context(u):
+            f=_current(u);g=f.geometry;x,y=int(round(x)),int(round(y))
+            if not _build.on_main(_safe_game,f.zone):raise RuntimeError('Build Mode changed during pointer operation')
+            _current(u)
+            if not (g[1]<=x<g[1]+g[3] and g[2]<=y<g[2]+g[4]):raise RuntimeError('Mouse point is outside the game window')
+            left,top,w,h=g[6]
+            nx=int(round((x-left)*65535/max(1,w-1)));ny=int(round((y-top)*65535/max(1,h-1)))
+            if not (0<=nx<=65535 and 0<=ny<=65535):raise RuntimeError('Mouse point outside virtual desktop')
+            if not u.SetCursorPos(x,y):raise RuntimeError('Pointer positioning failed')
+            u.mouse_event(0xc001,nx,ny,0,0)
+            p=display.POINT()
+            if not u.GetPhysicalCursorPos(ctypes.byref(p)) or abs(p.x-x)>2 or abs(p.y-y)>2:
+                raise RuntimeError('Physical pointer did not reach the requested point')
+            _local.last=(x,y)
+    except Exception:
+        _release(u);raise
+
+
+def _safe_game(zone):
+    import services
+    import tyjokr_a11y_place as place
+    import tyjokr_a11y_keys as keys
+    return place.in_build_mode() and int(services.current_zone_id())==zone and not keys.blocking_active() and not keys._editing_active
+
+
+def mouse(flags,data=0):
+    u=_api()
+    if flags==_build.LEFT_UP:
+        u.mouse_event(flags,0,0,data,0);_local.down=False;return
+    if flags!=_build.LEFT_DOWN:
+        return _original_mouse(flags,data)
+    try:
+        with physical_context(u):
+            f=_current(u)
+            if not _build.on_main(_safe_game,f.zone):raise RuntimeError('Build context changed before click')
+            p=display.POINT();last=getattr(_local,'last',None)
+            if last is None or not u.GetPhysicalCursorPos(ctypes.byref(p)) or max(abs(p.x-last[0]),abs(p.y-last[1]))>2:
+                raise RuntimeError('Pointer moved before click')
+            _current(u)
+            u.mouse_event(flags,0,0,data,0);_local.down=True
+    except Exception:
+        _release(u);raise
+
+
+def clear_of_panels(point):
+    try:
+        u=_api()
+        with physical_context(u):return _current(u).clear(point)
+    except Exception:return False
+
+
+def _guarded_action(original,args,shift):
+    u=_api()
+    with physical_context(u):
+        f=_current(u)
+        if shift and u.GetAsyncKeyState(0x10)&0x8000:raise RuntimeError('Release Shift before using this helper')
+        _local.input_frame=f
+        try:return original(*args,shift=shift)
+        finally:
+            _release(u)
+            if shift:u.keybd_event(0x10,0x2a,2,0)
+            _local.input_frame=None
+
+
+def park_mouse():
+    try:
+        u=_api()
+        with physical_context(u):
+            g=window(u)
+            u.SetCursorPos(g[1]+g[3]//2,g[2]+g[4]//3)
+    except Exception:pass
+
+
+def install():
+    global _build,_original_mouse
+    import tyjokr_a11y_plus_build as build
+    if getattr(build,'_measured_coordinates_installed',False):return
+    _build=build;_original_mouse=build._mouse
+    original_click,original_drag=build.click,build.drag
+    def click(a,shift=False):return _guarded_action(original_click,(a,),shift)
+    def drag(a,b,shift=False):return _guarded_action(original_drag,(a,b),shift)
+    build.project=project;build._stage_size=stage_size;build._to_screen=to_screen
+    build.move_to=move_to;build._mouse=mouse;build.click=click;build.drag=drag
+    build._clear_of_panels=clear_of_panels;build.park_mouse=park_mouse
+    build._measured_coordinates_installed=True
+    _log('installed')
+
+
+@sims4.commands.Command('a11y.buildcoords', command_type=sims4.commands.CommandType.Live)
+def preflight(delay: float=5,_connection=None):
+    if not math.isfinite(delay):return False
+    install()
+    def work():
+        def target():
+            import services
+            sim=services.get_active_sim()
+            if sim is None:raise RuntimeError('Load a household first')
+            return float(sim.position.x),float(sim.position.z),int(sim.level)
+        try:
+            point=_build.on_main(target)
+            if point is None:raise RuntimeError('Game target unavailable')
+            result,frame=_measure(*point)
+            # Mapping only: never call move_to, mouse, click, drag or park.
+            mapped=to_screen(*result['point']) if result['status']=='point' and frame.clear(result['point']) else None
+            _log('preflight',response=result,physical_point=mapped,window=frame.geometry)
+            text='Build coordinate check complete. No pointer movement or construction. See TS4 Access log.'
+        except Exception as exc:
+            _log('preflight-failed',error=str(exc));text='Build coordinate check failed: '+str(exc)
+        _build.core.post(lambda:speech.speak(text,explicit=True))
+    timer=threading.Timer(max(0,min(30,delay)),work);timer.daemon=True;timer.name='a11y_build_coordinate_check';timer.start()
+    sims4.commands.CheatOutput(_connection)('Read-only projection check scheduled. Close the console and keep Build Mode focused.')
+    return True
diff --git a/Scripts/tyjokr_a11y_build_helpers.py b/Scripts/tyjokr_a11y_build_helpers.py
